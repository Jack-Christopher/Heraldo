# Requerido para producción
JWT_SECRET=generate-a-secure-random-string

# Email (verificación de cuenta)
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
FRONTEND_URL=http://localhost:3001

# DeepSeek API (solo si usas --ai-provider deepseek)
DEEPSEEK_API_KEY=sk-...

# Límites de seguridad al usar DeepSeek (opcionales)
# Si se superan y no pasas --force, el pipeline se detiene.
DEEPSEEK_MAX_PAGES=
DEEPSEEK_MAX_TOKENS=
