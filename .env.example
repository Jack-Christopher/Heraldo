# Requerido para producción
JWT_SECRET=generate-a-secure-random-string

# TTS engine: gtts (works out of box) or piper (requires Piper binary)
TTS_ENGINE=gtts

# URL pública del frontend (donde los usuarios acceden a la app)
FRONTEND_URL=http://localhost:3001

# DeepSeek API (solo si usas --ai-provider deepseek)
DEEPSEEK_API_KEY=

# Límites de seguridad al usar DeepSeek (opcionales)
DEEPSEEK_MAX_PAGES=
DEEPSEEK_MAX_TOKENS=
