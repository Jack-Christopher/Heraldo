# Requerido para producción
JWT_SECRET=generate-a-secure-random-string

# MongoDB (autenticación obligatoria). Sin exponer puerto a internet.
MONGO_ROOT_USER=heraldo_admin
MONGO_ROOT_PASSWORD=generate-a-secure-password

# TTS engine: gtts (works out of box) or piper (requires Piper binary)
TTS_ENGINE=gtts

# URL pública del frontend (donde los usuarios acceden a la app)
FRONTEND_URL=http://localhost:3001

# DeepSeek API (solo si usas --ai-provider deepseek)
DEEPSEEK_API_KEY=

# Límites de seguridad al usar DeepSeek (opcionales)
DEEPSEEK_MAX_PAGES=
DEEPSEEK_MAX_TOKENS=

# Emails que serán admin (coma separada). La migración 005 los promoverá.
ADMIN_EMAILS=admin@example.com
